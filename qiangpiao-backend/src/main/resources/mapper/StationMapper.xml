<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiangpiao.mapper.StationMapper">

    <sql id="Base_Column_List">
        id, station_name, city, py_code, create_time
    </sql>

    <select id="selectAll" resultType="com.qiangpiao.dataobject.StationDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_station
        ORDER BY id
    </select>

    <select id="selectById" resultType="com.qiangpiao.dataobject.StationDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_station
        WHERE id = #{id}
    </select>

    <select id="selectByName" resultType="com.qiangpiao.dataobject.StationDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_station
        WHERE station_name = #{stationName}
        LIMIT 1
    </select>

    <select id="selectByKeyword" resultType="com.qiangpiao.dataobject.StationDO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_station
        WHERE station_name LIKE CONCAT('%', #{keyword}, '%')
           OR py_code LIKE CONCAT('%', #{keyword}, '%')
           OR city LIKE CONCAT('%', #{keyword}, '%')
        LIMIT 20
    </select>
</mapper>
